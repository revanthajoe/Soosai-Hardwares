PORT=5000
NODE_ENV=development
# Supabase Database URL (for raw pg connection)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/soosai_hardwares
SUPABASE_URL=your_supabase_url
# Must be the service_role key, NOT the publishable/anon key. The backend is
# the only authorization gate; RLS grants the anon role read-only access.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

PG_SSL=false
# Primary deployed frontend origin (used for CORS and links)
CLIENT_URL=http://localhost:5173
# Extra allowed CORS origins, comma-separated. localhost dev servers and this
# project's *.vercel.app deployments are always allowed.
CORS_ORIGIN=https://soosai-hardwares.vercel.app
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Admin login credentials. If either is unset, env-credential login is disabled
# and only database admin users can sign in. There are no built-in defaults.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ENABLE_CSRF=false
CSRF_COOKIE_NAME=csrf-token
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,webp
MAX_AD_IMAGE_FILE_SIZE=15728640
MAX_VIDEO_FILE_SIZE=104857600
